# Copy to ".env" (which is git-ignored) and change the password for any real deployment.
POSTGRES_DB=parcels
POSTGRES_USER=parcel
POSTGRES_PASSWORD=parcel_pass

# Host ports. 8090 avoids the Jenkins-deployed container on 8082 and Tomcat on 8081.
APP_PORT=8090
DB_PORT=5432

# true = load the 10 DEMO-xxxx parcels (db/demo) for a populated dashboard.
DB_SEED_DEMO=true

APP_TIMEZONE=Asia/Kolkata
# Optional: run a specific published image instead of building locally.
# APP_IMAGE=localhost:5000/parcel-tracking-portal:1.1.5
