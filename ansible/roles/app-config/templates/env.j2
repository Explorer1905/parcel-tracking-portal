# Parcel Tracking Portal – environment configuration
# Generated by Ansible (roles/app-config). Do NOT edit by hand.
# Secrets are supplied at ansible-playbook time via --ask-vault-pass or -e.

POSTGRES_DB={{ postgres_db | default('parcels') }}
POSTGRES_USER={{ postgres_user | default('parcel') }}
POSTGRES_PASSWORD={{ postgres_password }}

APP_PORT={{ app_port }}
DB_PORT={{ db_port }}

DB_SEED_DEMO={{ db_seed_demo | default('false') }}
APP_TIMEZONE={{ app_timezone | default('Asia/Kolkata') }}

DB_CONTAINER={{ compose_project }}-db
APP_CONTAINER={{ compose_project }}-app

# Image to deploy (set by deploy.yml via release_tag variable)
APP_IMAGE={{ registry_host }}/{{ image_repo }}:{{ release_tag | default('latest') }}
